{
  "name": "Test Action Extension",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "Test extension with action popup, icon, and service worker",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Test Action Extension",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
